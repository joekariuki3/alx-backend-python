pipeline {
  agent {
    docker {
      image 'python:3.10'
      args '-u root'
    }
  }

  options {
    ansiColor('xterm')
    timestamps()
  }

  parameters {
    string(name: 'GIT_REPO', defaultValue: 'https://github.com/joekariuki3/alx-backend-python/tree/master/messaging_app', description: 'GitHub repository URL')
    string(name: 'GIT_BRANCH', defaultValue: 'master', description: 'Branch to build')
    string(name: 'GIT_CREDENTIALS_ID', defaultValue: 'github-creds', description: 'Jenkins credentialsId for GitHub (PAT/Username+Token or SSH)')
  }

  environment {
    PATH = "$HOME/.local/bin:$PATH"
    PYTHONDONTWRITEBYTECODE = '1'
    PYTHONUNBUFFERED = '1'
  }

    stages {
    stage('Checkout') {
      steps {
        git branch: params.GIT_BRANCH, credentialsId: params.GIT_CREDENTIALS_ID, url: params.GIT_REPO
      }
    }



     stage('Set up Python venv') {
      steps {
        sh '''
          set -eux
          python -m venv .venv
          .venv/bin/python -m pip3 install --upgrade pip3 setuptools wheel
        '''
      }
    }


   stage('Install dependencies') {
      steps {
        sh '''
          set -eux
          if [ -f requirements.txt ]; then
            .venv/bin/pip3 install -r messaging_app/requirements.txt
          else
            echo "requirements.txt not found. Installing pytest so tests can run; add a requirements.txt for reproducible installs." >&2
            .venv/bin/pip install pytest
          fi
        '''
      }
    }


    stage('Run tests') {
      steps {
        sh '''
          set -eux
          mkdir -p reports
          .venv/bin/pytest -q --junitxml=reports/junit.xml
        '''
      }
      post {
        always {
          junit testResults: 'reports/junit.xml', allowEmptyResults: true
          archiveArtifacts artifacts: 'reports/**', onlyIfSuccessful: false
        }
      }
    }
  }

  post {
    always {
      echo 'Pipeline finished.'
    }
    success {
      echo 'Build succeeded.'
    }
    failure {
      echo 'Build failed.'
    }
  }
}